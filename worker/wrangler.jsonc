{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "blackraven-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGINS": "https://blackraven.solutions,https://www.blackraven.solutions,https://dday2301.github.io"
  },
  "ratelimits": [
    { "name": "CONTACT_PER_IP", "namespace_id": "842171", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_GLOBAL", "namespace_id": "842172", "simple": { "limit": 12, "period": 60 } }
  ]
}
